<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_vehicle_approval" model="ir.ui.view">
        <field name="name">sale.order.form.vehicle.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="vehicle_number"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_approve" string="Approve" type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'to_approve')]}"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_reject" string="Reject" type="object"
                        attrs="{'invisible': [('state', '!=', 'to_approve')]}"
                        groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,to_approve,sale</attribute>
            </xpath>
        </field>
    </record>
</odoo>
