<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tyre_master_tree" model="ir.ui.view">
        <field name="name">tyre.master.tree</field>
        <field name="model">tyre.master</field>
        <field name="arch" type="xml">
            <tree decoration-danger="condition == 'replace'" decoration-warning="condition == 'warning'">
                <field name="name"/>
                <field name="brand"/>
                <field name="vehicle_id"/>
                <field name="position"/>
                <field name="wear_level"/>
                <field name="temperature"/>
                <field name="condition" widget="badge"
                       decoration-success="condition == 'good'"
                       decoration-warning="condition == 'warning'"
                       decoration-danger="condition == 'replace'"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_tyre_master_form" model="ir.ui.view">
        <field name="name">tyre.master.form</field>
        <field name="model">tyre.master</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_scrap" type="object" string="Scrap tyre"
                            attrs="{'invisible': [('state', '=', 'scrap')]}"
                            confirm="Scrap this tyre and remove it from the vehicle?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. MRF-2026-00123"/></h1>
                    </div>
                    <group>
                        <group string="Tyre">
                            <field name="brand"/>
                            <field name="size"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="position" readonly="1"/>
                            <field name="axle"/>
                        </group>
                        <group string="Readings">
                            <field name="speed"/>
                            <field name="temperature"/>
                            <field name="odometer"/>
                            <field name="wear_level"/>
                            <field name="condition"/>
                        </group>
                    </group>
                    <field name="fitment_ids" readonly="1">
                        <tree>
                            <field name="fitment_date"/>
                            <field name="vehicle_id"/>
                            <field name="position"/>
                            <field name="odometer_at_fit"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tyre_fitment_tree" model="ir.ui.view">
        <field name="name">tyre.fitment.tree</field>
        <field name="model">tyre.fitment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="fitment_date"/>
                <field name="tyre_id"/>
                <field name="vehicle_id"/>
                <field name="position"/>
                <field name="odometer_at_fit"/>
            </tree>
        </field>
    </record>

    <record id="view_tyre_fitment_form" model="ir.ui.view">
        <field name="name">tyre.fitment.form</field>
        <field name="model">tyre.fitment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="tyre_id" domain="[('state', '!=', 'scrap')]"/>
                            <field name="vehicle_id"/>
                            <field name="position"/>
                        </group>
                        <group>
                            <field name="fitment_date"/>
                            <field name="odometer_at_fit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tyre_master" model="ir.actions.act_window">
        <field name="name">Tyres</field>
        <field name="res_model">tyre.master</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_tyre_fitment" model="ir.actions.act_window">
        <field name="name">Fitments</field>
        <field name="res_model">tyre.fitment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_tyre_root" name="Tyre Tracking" parent="mrp.menu_mrp_root" sequence="45"/>
    <menuitem id="menu_tyre_dashboard" name="Tyre Dashboard" parent="menu_tyre_root" action="action_tyre_dashboard" sequence="1"/>
    <menuitem id="menu_tyre_master" name="Tyres" parent="menu_tyre_root" action="action_tyre_master" sequence="2"/>
    <menuitem id="menu_tyre_fitment" name="Fitments" parent="menu_tyre_root" action="action_tyre_fitment" sequence="3"/>
</odoo>
